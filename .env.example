# Copia este fichero como .env. Los valores de Langfuse ya funcionan con el
# docker-compose.yml de este repositorio: el proyecto y sus claves se crean al arrancar.

# --- Langfuse local ---------------------------------------------------------
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-nexus-academy
LANGFUSE_SECRET_KEY=sk-lf-nexus-academy
# Usuario para entrar en la interfaz (http://localhost:3100).
LANGFUSE_INIT_USER_EMAIL=equipo@metrovilaverda.test
LANGFUSE_INIT_USER_PASSWORD=academy-password

# --- Proveedor del modelo ---------------------------------------------------
# Cada nodo usa un modelo con formato proveedor:nombre. Por defecto, los dos nodos usan
# groq:llama-3.3-70b-versatile; descomenta una línea solo si quieres cambiarlo.

# Groq (recomendado). Crea tu clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
# MODELS__ORCHESTRATOR__MODEL=groq:llama-3.3-70b-versatile
# MODELS__EXECUTOR__MODEL=groq:llama-3.3-70b-versatile
# Modelos que razonan (su razonamiento se oculta en la respuesta):
# MODELS__EXECUTOR__MODEL=groq:openai/gpt-oss-120b
# MODELS__EXECUTOR__MODEL=groq:qwen/qwen3-32b

# Alternativa: un servidor compatible con la API de OpenAI (proveedor "openai").
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=
# MODELS__ORCHESTRATOR__MODEL=openai:nombre-del-modelo
# MODELS__EXECUTOR__MODEL=openai:nombre-del-modelo

# Alternativa: modelos en local con Ollama (proveedor "ollama").
# OLLAMA_HOST=http://localhost:11434
# MODELS__ORCHESTRATOR__MODEL=ollama:qwen3:4b-instruct
# MODELS__EXECUTOR__MODEL=ollama:qwen3:4b-instruct

# --- Búsqueda en la normativa (RAG) -----------------------------------------
# Estrategia: bm25 (sin modelo) o embeddings (usa RAG__EMBEDDING_MODEL).
RAG__STRATEGY=bm25
RAG__CHUNK_SIZE=250
RAG__TOP_K=4
RAG__ONLY_CURRENT=false
# RAG__EMBEDDING_MODEL=ollama:nomic-embed-text-v2-moe

# --- Tiempos -----------------------------------------------------------------
LLM_CALL_TIMEOUT_SECONDS=120
